#Binary search
a=[10,20,30,40,50]

key=int(input("Eneter the element to be searched:"))

low=0
high=len(a)-1

while low<=high:
    mid=(low+high)//2
    
    if a[mid]==key:
        print("Element found at index:",mid)
        break
    elif mid<key:
        low=mid+1 
    else:
        high=mid-1
else:
    print("Element not found")


