#2Removing duplicate from array
#Given a sorted array nums, remove the duplicates in-place such that each unique element appears only once and return the number of unique elements (k).

class Solution:
    def removeDuplicates(self, nums):
        n = len(nums)

        start = 0

        for i in range(1, n):
            # Unique element
            if nums[i] != nums[start]:
                start += 1
                nums[start] = nums[i]

        return start + 1


nums = [3, 3, 5, 5, 5, 7, 7, 9, 9]

obj = Solution()
result = obj.removeDuplicates(nums)

print("Modified array", nums)
print("Number of unique elements:", result)
print("Array after removing duplicates:", nums[:result])
